generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════
// PHASE 0 - AUTH
// ═══════════════════════════════════════════════════════════

enum UserRole {
  GENERAL_MANAGER
  COMPANY_MANAGER
  ACCOUNTANT
  MAINTENANCE_MANAGER
  WORKSHOP_MANAGER
  ENGINEER
  SALES_EMPLOYEE
  HR_MANAGER
  EMPLOYEE
}

enum NotificationCategory {
  GENERAL
  SYSTEM
  SERVICE_REQUEST
  MACHINE
  INVENTORY
  PAYMENT
  CONTRACT
  HR
  PAYROLL
  LEAVE
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationType {
  SYSTEM
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_ASSIGNED
  SERVICE_REQUEST_UPDATED
  MACHINE_STATUS_CHANGED
  CONTRACT_EXPIRING
  LOW_STOCK
  PAYMENT_PENDING
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  OVERTIME_REQUESTED
  OVERTIME_APPROVED
  ADVANCE_REQUESTED
  ADVANCE_APPROVED
  PAYROLL_READY
  PAYROLL_APPROVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  companyId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settlements         Settlement[]   @relation("SettlementCollectedBy")
  verifiedSettlements Settlement[]   @relation("SettlementVerifiedBy")
  expenses            Expense[]
  approvalLogs        ApprovalLog[]
  sessions            Session[]
  notifications       Notification[] @relation("UserNotifications")
  sentNotifications   Notification[] @relation("NotificationSender")
  engineer            Engineer?
  employee            Employee?
  company             Company?       @relation(fields: [companyId], references: [id])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  senderId   String?
  title      String
  message    String
  type       NotificationType     @default(SYSTEM)
  category   NotificationCategory @default(GENERAL)
  entityType String?
  entityId   String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  priority   NotificationPriority @default(NORMAL)
  metadata   Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user   User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// PHASE 1 - CORE
// ═══════════════════════════════════════════════════════════

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Company {
  id            String   @id @default(cuid())
  name          String   @unique
  nameAr        String?
  taxNumber     String?
  tradeRegister String?
  address       String?
  phone         String?
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users                 User[]
  ledgers               CustomerLedger[]
  suppliers             Supplier[]
  products              Product[]
  returnTransactions    ReturnTransaction[]
  warehouses            Warehouse[]
  purchaseOrders        PurchaseOrder[]
  salesOrders           SalesOrder[]
  interCompanySales     InterCompanyInvoice[] @relation("InterCompanySales")
  interCompanyPurchases InterCompanyInvoice[] @relation("InterCompanyPurchases")
  expenses              Expense[]
  expenseCategories     ExpenseCategory[]
  salesCategories       SalesCategory[]
  settlements           Settlement[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  payments              CustomerPayment[]
  workshopBooks         WorkshopDailyBook[]
  workshopTransactions  WorkshopTransaction[]
  departments           Department[]
  jobTitles             JobTitle[]
  shifts                Shift[]
  holidays              Holiday[]
  employees             Employee[]
  payrollPeriods        PayrollPeriod[]
  payrollRuns           PayrollRun[]
  salaryComponents      SalaryComponent[]
}

model Customer {
  id              String       @id @default(cuid())
  name            String
  companyName     String?
  contactPerson   String?
  phone           String?
  whatsapp        String?
  email           String?
  address         String?
  city            String?
  governorate     String?
  notes           String?
  gpsLat          Float?
  gpsLng          Float?
  taxNumber       String?
  tradeRegister   String?
  creditLimit     Float        @default(0)
  paymentTerms    String?
  customerType    CustomerType @default(INDIVIDUAL)
  isActive        Boolean      @default(true)
  totalDebt       Float        @default(0)
  remainingDebt   Float        @default(0)
  lastPaymentDate DateTime?
  statementToken  String?      @unique
  engineerId      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  engineer          Engineer?      @relation(fields: [engineerId], references: [id])
  locations         CustomerLocation[]
  ledgers           CustomerLedger[]
  orders            SalesOrder[]
  serviceRequests   ServiceRequest[]
  contracts         Contract[]
  machineOwnerships MachineOwnerHistory[]
  machines          Machine[]
  settlements       Settlement[]
  returns           ReturnTransaction[]
  payments          CustomerPayment[]
  copierTests       CopierTest[]
}

model CustomerPayment {
  id          String    @id @default(cuid())
  customerId  String
  companyId   String?
  amount      Float
  paymentDate DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model CustomerLocation {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  address     String?
  city        String?
  governorate String?
  gpsLat      Float?
  gpsLng      Float?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  machines        Machine[]
  serviceRequests ServiceRequest[]
}

model CustomerLedger {
  id         String @id @default(cuid())
  customerId String
  companyId  String
  balance    Float  @default(0)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([customerId, companyId])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  taxNumber   String?
  companyId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  invoices       PurchaseInvoice[]
  returns        ReturnTransaction[]
}

model Engineer {
  id                 String   @id @default(cuid())
  userId             String?  @unique
  name               String
  phone              String?
  email              String?
  nationalId         String?
  baseSalary         Float    @default(8000)
  transportAllowance Float    @default(2000)
  commissionRate     Float    @default(25)
  isActive           Boolean  @default(true)
  statementToken     String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  areas           EngineerArea[]
  skills          EngineerSkill[]
  serviceRequests ServiceRequest[]
  visits          Visit[]
  custodyItems    SparePartCustody[]
  salaryRecords   EngineerSalary[]
  user            User?              @relation(fields: [userId], references: [id])
  settlements     Settlement[]
  warranties      Warranty[]
  salesOrders     SalesOrder[]
  copierTests     CopierTest[]
  customers       Customer[]
  employee        Employee?
}

model EngineerArea {
  id         String  @id @default(cuid())
  engineerId String
  areaName   String
  isDefault  Boolean @default(true)

  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([engineerId, areaName])
}

model EngineerSkill {
  id         String @id @default(cuid())
  engineerId String
  modelType  String
  skillLevel Int    @default(1)

  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@unique([engineerId, modelType])
}

model Investor {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?
  ownershipPct Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  distributions InvestorDistribution[]
}

model InvestorDistributionCycle {
  id          String   @id @default(cuid())
  cycleDate   DateTime
  totalProfit Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  distributions InvestorDistribution[]
}

model InvestorDistribution {
  id         String    @id @default(cuid())
  cycleId    String
  investorId String
  amount     Float
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  cycle    InvestorDistributionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  investor Investor                  @relation(fields: [investorId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// PHASE 2 - MACHINES & INVENTORY
// ═══════════════════════════════════════════════════════════

enum ProductType {
  MACHINE
  SPARE_PART
}

enum MachineStatus {
  SOLD
  RENTED
  IN_WAREHOUSE
  UNDER_MAINTENANCE
  UNDER_INSPECTION
  SCRAPPED
}

enum PaperSize {
  A3
  A4
  A3_A4
}

enum TransactionType {
  SALE
  RENTAL
  RETURN
  TRADE_IN
  TRANSFER
  MAINTENANCE
  SCRAP
}

enum ReturnType {
  SALE_RETURN
  PURCHASE_RETURN
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReadingSource {
  MANUAL
  OCR
  SCANNER
}

enum StockMovementType {
  PURCHASE_IN
  INTER_COMPANY_IN
  INTER_COMPANY_OUT
  SALE_OUT
  SALE_RETURN_IN
  PURCHASE_RETURN_OUT
  ENGINEER_CUSTODY_OUT
  ENGINEER_RETURN
  CONSUMED
  SCRAP
  ADJUSTMENT
}

enum CustodyStatus {
  ISSUED
  PARTIALLY_USED
  FULLY_USED
  RETURNED
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String?
  productType    ProductType
  companyId      String
  sku            String?
  gs1Code        String?
  egsCode        String?
  purchasePrice  Float?
  wholesalePrice Float?
  retailPrice    Float?
  pricingTiers   Json?
  isActive       Boolean     @default(true)
  isTradeIn      Boolean     @default(false)
  tradeInValue   Float?
  brand          String?
  condition      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  machines                 Machine[]
  orderItems               SalesOrderItem[]         @relation("OrderItems")
  tradeInItems             SalesOrderItem[]         @relation("TradeInItems")
  purchaseItems            PurchaseOrderItem[]
  inventoryItems           WarehouseInventory[]
  custodies                SparePartCustody[]
  stockMovements           StockMovement[]
  returnTransactions       ReturnTransaction[]
  sparePartCompatibilities SparePartCompatibility[] @relation("SparePartCompat")
  compatibleMachines       SparePartCompatibility[] @relation("CompatibleMachine")
}

model Machine {
  id                 String        @id @default(cuid())
  serialNumber       String        @unique
  manufacturer       String?
  model              String?
  isColor            Boolean       @default(false)
  paperSize          PaperSize     @default(A4)
  currentStatus      MachineStatus @default(IN_WAREHOUSE)
  purchaseDate       DateTime?
  purchasePrice      Float?
  salePrice          Float?
  saleDate           DateTime?
  notes              String?
  deliveryBlack      Int?
  deliveryColor      Int?
  isPrinter          Boolean       @default(false)
  productId          String?
  currentOwnerId     String?
  customerLocationId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  product          Product?              @relation(fields: [productId], references: [id])
  currentOwner     Customer?             @relation(fields: [currentOwnerId], references: [id])
  customerLocation CustomerLocation?     @relation(fields: [customerLocationId], references: [id])
  history          MachineOwnerHistory[]
  meterReadings    MeterReading[]
  serviceRequests  ServiceRequest[]
  contracts        ContractMachine[]
  scrapOrder       ScrapOrder?
  warranty         Warranty?
  copierTests      CopierTest[]
}

model MachineOwnerHistory {
  id              String          @id @default(cuid())
  machineId       String
  transactionType TransactionType
  customerId      String?
  companyId       String
  date            DateTime        @default(now())
  financialValue  Float?
  notes           String?
  salesOrderId    String?
  contractId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  machine  Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
}

model MeterReading {
  id          String        @id @default(cuid())
  machineId   String
  reading     Int
  source      ReadingSource @default(MANUAL)
  readingDate DateTime      @default(now())
  visitId     String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model SparePartCompatibility {
  id             String @id @default(cuid())
  sparePartId    String
  machineModelId String

  sparePart    Product @relation("SparePartCompat", fields: [sparePartId], references: [id], onDelete: Cascade)
  machineModel Product @relation("CompatibleMachine", fields: [machineModelId], references: [id], onDelete: Cascade)

  @@unique([sparePartId, machineModelId])
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  companyId String
  isMain    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventory          WarehouseInventory[]
  stockMovements     StockMovement[]
  returnTransactions ReturnTransaction[]
}

model WarehouseInventory {
  id          String @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int    @default(0)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

model StockMovement {
  id              String            @id @default(cuid())
  warehouseId     String
  productId       String
  quantity        Int
  movementType    StockMovementType
  referenceId     String?
  purchaseOrderId String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
}

model ReturnTransaction {
  id               String       @id @default(cuid())
  companyId        String
  type             ReturnType
  salesOrderId     String?
  salesOrderItemId String?
  purchaseOrderId  String?
  purchaseOrderItemId String?
  priceTier        String?
  warehouseId      String?
  customerId       String?
  supplierId       String?
  productId        String
  quantity         Int
  unitPrice        Float
  total            Float
  reason           String?
  status           ReturnStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder         SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  salesOrderItem     SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id])
  purchaseOrder      PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem  PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  warehouse          Warehouse?         @relation(fields: [warehouseId], references: [id])
  customer           Customer?          @relation(fields: [customerId], references: [id])
  supplier           Supplier?          @relation(fields: [supplierId], references: [id])
  product            Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SparePartCustody {
  id               String        @id @default(cuid())
  engineerId       String
  productId        String
  quantityIssued   Int           @default(0)
  quantityUsed     Int           @default(0)
  quantityReturned Int           @default(0)
  status           CustodyStatus @default(ISSUED)
  issuedAt         DateTime
  visitId          String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// PHASE 3 - PURCHASING
// ═══════════════════════════════════════════════════════════

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  companyId  String
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  total      Float               @default(0)
  notes      String?
  orderDate  DateTime
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]
  invoices PurchaseInvoice[]
  returns  ReturnTransaction[]
  movements StockMovement[]
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  returns       ReturnTransaction[]
}

model PurchaseInvoice {
  id              String   @id @default(cuid())
  companyId       String
  supplierId      String
  purchaseOrderId String?
  invoiceNumber   String
  total           Float
  invoiceDate     DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
}

model InterCompanyInvoice {
  id                   String   @id @default(cuid())
  fromCompanyId        String
  toCompanyId          String
  invoiceNumber        String
  total                Float
  invoiceDate          DateTime
  purchaseOrderId      String?
  salesOrderId         String?
  notes                String?
  internalPaymentMethod String  @default("CREDIT")
  internalPaidAmount   Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  fromCompany Company @relation("InterCompanySales", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompany   Company @relation("InterCompanyPurchases", fields: [toCompanyId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// PHASE 4 - SALES & CONTRACTS
// ═══════════════════════════════════════════════════════════

enum OrderType {
  MACHINE_SALE
  SPARE_PART_SALE
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT
  INSTALLMENT
  MIXED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum ContractType {
  ARCHIVE
  RENTAL
  MAINTENANCE
  VISIT
  WARRANTY
  CONTRACT_REQUIRED
  MAINTENANCE_ONLY
  MAINTENANCE_AND_PARTS
  MAINTENANCE_AND_PRINTING
  PENDING
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  HALF_YEARLY
  QUARTERLY
  YEARLY
}

model SalesCategory {
  id        String   @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  SalesOrder[]

  @@unique([companyId, name])
}

model SalesOrder {
  id            String           @id @default(cuid())
  companyId     String
  customerId    String
  engineerId    String?
  categoryId    String?
  orderType     OrderType
  status        SalesOrderStatus @default(CONFIRMED)
  total         Float            @default(0)
  discount      Float            @default(0)
  discountType  DiscountType     @default(FIXED)
  taxRate       Float            @default(0)
  isTaxInvoice  Boolean          @default(false)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus    @default(PENDING)
  paidAmount    Float            @default(0)
  creditUsed    Float            @default(0)
  tradeInTotal  Float            @default(0)
  notes         String?
  orderDate     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  engineer     Engineer?           @relation(fields: [engineerId], references: [id])
  salesCategory SalesCategory?     @relation(fields: [categoryId], references: [id])
  items        SalesOrderItem[]
  installments Installment[]
  returns      ReturnTransaction[]
}

model SalesOrderItem {
  id               String   @id @default(cuid())
  salesOrderId     String
  productId        String
  quantity         Int
  unitPrice        Float
  discount         Float    @default(0)
  tradeInProductId String?
  tradeInValue     Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  salesOrder     SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product        Product             @relation("OrderItems", fields: [productId], references: [id], onDelete: Cascade)
  tradeInProduct Product?            @relation("TradeInItems", fields: [tradeInProductId], references: [id])
  returns        ReturnTransaction[]
}

model Installment {
  id            String            @id @default(cuid())
  salesOrderId  String
  installmentNo Int
  amount        Float
  dueDate       DateTime
  paidDate      DateTime?
  status        InstallmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model Contract {
  id                  String         @id @default(cuid())
  contractNumber      String         @unique
  customerId          String
  contractType        ContractType
  status              ContractStatus @default(ACTIVE)
  startDate           DateTime
  endDate             DateTime
  value               Float
  amountPaid          Float          @default(0)
  paymentMethod       PaymentMethod  @default(CASH)
  billingCycle        BillingCycle
  visitLimit          Int?
  costPerCopy         Float?
  earlyTerminationFee Float?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  machines ContractMachine[]
  visits   Visit[]
}

model ContractMachine {
  id         String @id @default(cuid())
  contractId String
  machineId  String

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  machine  Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([contractId, machineId])
}

// ═══════════════════════════════════════════════════════════
// PHASE 5 - SERVICE
// ═══════════════════════════════════════════════════════════

enum Priority {
  NORMAL
  IMPORTANT
  URGENT
  EMERGENCY
}

enum RequestStatus {
  NEW
  ASSIGNED
  VISITED
  RESOLVED
  NOT_RESOLVED
  REASSIGNED
  CLOSED
}

model ServiceRequest {
  id             String        @id @default(cuid())
  requestNumber  String        @unique
  customerId     String
  locationId     String?
  machineId      String?
  description    String
  priority       Priority      @default(NORMAL)
  status         RequestStatus @default(NEW)
  engineerId     String?
  companyId      String
  customerRating Int?
  ratingNotes    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location CustomerLocation? @relation(fields: [locationId], references: [id])
  machine  Machine?          @relation(fields: [machineId], references: [id])
  engineer Engineer?         @relation(fields: [engineerId], references: [id])
  problems ProblemDetail[]
  visits   Visit[]
}

model ProblemDetail {
  id               String   @id @default(cuid())
  serviceRequestId String
  description      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
}

model Visit {
  id               String   @id @default(cuid())
  serviceRequestId String
  engineerId       String
  contractId       String?
  visitedAt        DateTime
  resolved         Boolean  @default(false)
  resolutionNotes  String?
  partsUsed        String?
  meterReadingId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  engineer       Engineer       @relation(fields: [engineerId], references: [id], onDelete: Cascade)
  contract       Contract?      @relation(fields: [contractId], references: [id])
}

// ═══════════════════════════════════════════════════════════
// PHASE 6 - WORKSHOP
// ═══════════════════════════════════════════════════════════

enum ScrapStatus {
  PENDING
  APPROVED
  REJECTED
}

model ScrapOrder {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  machineId   String      @unique
  reason      String
  approvedBy  String
  scrapValue  Float?
  status      ScrapStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// PHASE 7 - FINANCE
// ═══════════════════════════════════════════════════════════

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum SettlementStatus {
  INITIAL
  VERIFIED
}

enum SettlementDirection {
  ADDITION
  SUBTRACTION
}

model Account {
  id          String      @id @default(cuid())
  code        String
  name        String
  accountType AccountType
  companyId   String
  balance     Float       @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalItems JournalEntryItem[]
}

model JournalEntry {
  id            String   @id @default(cuid())
  companyId     String
  entryNumber   String
  date          DateTime
  description   String
  referenceType String?
  referenceId   String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   JournalEntryItem[]
}

model JournalEntryItem {
  id             String @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Float  @default(0)
  credit         Float  @default(0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Settlement {
  id               String             @id @default(cuid())
  settlementNumber String             @unique
  companyId        String
  customerId       String?
  engineerId       String?
  amount           Float
  paymentMethod    PaymentMethod
  reason           String
  direction        SettlementDirection @default(ADDITION)
  status           SettlementStatus   @default(INITIAL)
  collectedBy      String
  verifiedBy       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id])
  engineer  Engineer? @relation(fields: [engineerId], references: [id])
  collector User      @relation("SettlementCollectedBy", fields: [collectedBy], references: [id])
  verifier  User?     @relation("SettlementVerifiedBy", fields: [verifiedBy], references: [id])
}

model ApprovalLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]
  workshopTransactions WorkshopTransaction[]

  @@unique([companyId, name])
}

model Expense {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String?
  category    String
  description String
  amount      Float
  paidBy      String
  receiptUrl  String?
  accountCode String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payer    User             @relation(fields: [paidBy], references: [id])
  expenseCategory ExpenseCategory? @relation(fields: [categoryId], references: [id])
}

// ═══════════════════════════════════════════════════════════
// PHASE 8 - WARRANTY & ENGINEER SALARY
// ═══════════════════════════════════════════════════════════

model Warranty {
  id              String   @id @default(cuid())
  machineId       String   @unique
  startDate       DateTime
  endDate         DateTime
  copyLimit       Int?
  copyLimitMonths Int?
  isExpired       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  machine    Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  engineer   Engineer? @relation(fields: [engineerId], references: [id])
  engineerId String?
}

// ═══════════════════════════════════════════════════════════
// PHASE 9 - BANK RECONCILIATION
// ═══════════════════════════════════════════════════════════

model BankReconciliation {
  id               String   @id @default(cuid())
  companyId        String
  accountCode      String
  statementDate    DateTime
  statementBalance Float
  systemBalance    Float
  difference       Float
  isReconciled     Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// PHASE 8 - WARRANTY & ENGINEER SALARY
// ═══════════════════════════════════════════════════════════

model EngineerSalary {
  id                 String    @id @default(cuid())
  engineerId         String
  month              Int
  year               Int
  baseSalary         Float
  transportAllowance Float
  totalSales         Float     @default(0)
  totalCostOfGoods   Float     @default(0)
  commissionAmount   Float     @default(0)
  totalDeductions    Float     @default(0)
  netPayable         Float     @default(0)
  isPaid             Boolean   @default(false)
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  engineer Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// PHASE 11 - WORKSHOP DAILY CASHBOX (يومية الورشة)
// ═══════════════════════════════════════════════════════════

enum WorkshopBookStatus {
  OPEN
  CLOSED
}

enum WorkshopTxDirection {
  IN
  OUT
}

enum WorkshopTxStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model WorkshopDailyBook {
  id              String             @id @default(cuid())
  companyId       String
  bookDate        DateTime
  status          WorkshopBookStatus @default(OPEN)
  notes           String?
  openedBy        String
  closedBy        String?
  closedAt        DateTime?
  handoverAmount  Float?
  handoverTo      String?
  handoverNote    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company      Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions WorkshopTransaction[]

  @@index([companyId, status])
}

model WorkshopTransaction {
  id           String              @id @default(cuid())
  bookId       String
  companyId    String
  direction    WorkshopTxDirection
  amount       Float
  categoryId   String?
  reason       String
  status       WorkshopTxStatus    @default(PENDING)
  createdBy    String
  confirmedBy  String?
  confirmedAt  DateTime?
  rejectReason String?
  expenseId    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  book     WorkshopDailyBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([bookId, status])
}

// ═══════════════════════════════════════════════════════════
// PHASE 10 - COPIER TESTS (اختبارات آلات التصوير)
// ═══════════════════════════════════════════════════════════

model CopierTest {
  id               String   @id @default(cuid())
  customerId       String
  engineerId       String?
  machineId        String?
  pageCount        Int
  blackCounter     Int?
  colorCounter     Int?
  repairStatement  String?
  spareParts       String?
  collectedAmount  Float?
  collectionNote   String?
  imageUrl         String?
  imagePublicId    String?
  notes            String?
  testDate         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  engineer Engineer? @relation(fields: [engineerId], references: [id], onDelete: Restrict)
  machine  Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([customerId, testDate])
}

// ═══════════════════════════════════════════════════════════
// PHASE 12 - HR, PAYROLL & ATTENDANCE MODULE
// ═══════════════════════════════════════════════════════════

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TRAINEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum ShiftType {
  FIXED
  FLEXIBLE
  ROTATING
}

enum PunchSource {
  FINGERPRINT_DEVICE
  MOBILE_GPS
  WEB_MANUAL
  API_IMPORT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  REST_DAY
}

enum LeaveTypeCategory {
  ANNUAL
  SICK
  UNPAID
  EMERGENCY
  MATERNITY
  PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DEDUCTING
  COMPLETED
}

enum InstallmentPayStatus {
  PENDING_PAY
  PAID
  CANCELLED
}

enum SalaryComponentType {
  ALLOWANCE
  DEDUCTION
  BONUS
  COMMISSION
  PENALTY
}

enum CalculationType {
  FIXED_AMOUNT
  PERCENTAGE_OF_BASIC
  DAILY_RATE
  HOURLY_RATE
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  LOCKED
}

enum PayrollItemFlag {
  NONE
  NEGATIVE_NET
  HIGH_DEDUCTION
  MISSING_PUNCHES
}

model Department {
  id          String     @id @default(cuid())
  code        String
  name        String
  nameAr      String?
  managerId   String?
  companyId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Employees   Employee[]

  @@unique([companyId, code])
}

model JobTitle {
  id          String     @id @default(cuid())
  title       String
  titleAr     String?
  companyId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  Company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Employees   Employee[]
}

model Shift {
  id            String     @id @default(cuid())
  name          String
  shiftType     ShiftType  @default(FIXED)
  startTime     String
  endTime       String
  gracePeriod   Int        @default(15)
  halfDayMinutes Int       @default(240)
  overtimeStart String?
  companyId     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  Company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Employees     Employee[]
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  startDate DateTime
  endDate   DateTime
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Employee {
  id                     String           @id @default(cuid())
  code                   String           @unique
  fingerprintId          String?          @unique
  fullName               String
  fullNameAr             String?
  nationalId             String?          @unique
  phone                  String?
  email                  String?
  hireDate               DateTime
  employmentType         EmploymentType   @default(FULL_TIME)
  status                 EmploymentStatus @default(ACTIVE)
  baseSalary             Float            @default(0)
  currency               String           @default("EGP")
  departmentId           String?
  jobTitleId             String?
  shiftId                String?
  companyId              String
  userId                 String?          @unique
  engineerId             String?          @unique
  notes                  String?
  annualLeaveBalance     Float            @default(21)
  sickLeaveBalance       Float            @default(7)
  emergencyLeaveBalance  Float            @default(5)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  Company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Department             Department?             @relation(fields: [departmentId], references: [id])
  JobTitle               JobTitle?               @relation(fields: [jobTitleId], references: [id])
  Shift                  Shift?                  @relation(fields: [shiftId], references: [id])
  User                   User?                   @relation(fields: [userId], references: [id])
  Engineer               Engineer?               @relation(fields: [engineerId], references: [id])
  RawPunches             RawAttendancePunch[]
  DailyAttendance        DailyAttendanceRecord[]
  LeaveRequests          LeaveRequest[]
  SalaryHistory          EmployeeSalaryHistory[]
  SalaryComponents       EmployeeSalaryComponent[]
  Advances               EmployeeAdvance[]
  Loans                  EmployeeLoan[]
  PayrollItems           PayrollItem[]
  TraineeInfo            TraineeInfo?

  @@index([companyId, status])
}

model RawAttendancePunch {
  id            String      @id @default(cuid())
  employeeId    String
  punchTime     DateTime
  source        PunchSource @default(FINGERPRINT_DEVICE)
  deviceId      String?
  rawPayload    String?
  createdAt     DateTime    @default(now())
  Employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, punchTime])
}

model DailyAttendanceRecord {
  id            String           @id @default(cuid())
  employeeId    String
  date          DateTime
  firstIn       DateTime?
  lastOut       DateTime?
  workedMinutes Int              @default(0)
  lateMinutes   Int              @default(0)
  earlyLeaveMin Int              @default(0)
  overtimeMin   Int              @default(0)
  status        AttendanceStatus @default(PRESENT)
  isManual      Boolean          @default(false)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  Employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model LeaveRequest {
  id           String            @id @default(cuid())
  employeeId   String
  category     LeaveTypeCategory @default(ANNUAL)
  startDate    DateTime
  endDate      DateTime
  daysCount    Float
  reason       String
  status       LeaveStatus       @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  rejectReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  Employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

model EmployeeSalaryHistory {
  id             String    @id @default(cuid())
  employeeId     String
  oldBaseSalary  Float
  newBaseSalary  Float
  effectiveDate  DateTime
  reason         String?
  changedBy      String
  createdAt      DateTime  @default(now())
  Employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model SalaryComponent {
  id              String                 @id @default(cuid())
  name            String
  type            SalaryComponentType
  calcType        CalculationType        @default(FIXED_AMOUNT)
  defaultValue    Float                  @default(0)
  isTaxable       Boolean                @default(false)
  isInsurance     Boolean                @default(false)
  companyId       String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  Company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  EmployeeLinks   EmployeeSalaryComponent[]
  PayrollItemBreakdowns PayrollItemComponent[]
}

model EmployeeSalaryComponent {
  id                String          @id @default(cuid())
  employeeId        String
  salaryComponentId String
  overrideValue     Float?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  Employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  SalaryComponent   SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: Cascade)

  @@unique([employeeId, salaryComponentId])
}

model EmployeeAdvance {
  id            String        @id @default(cuid())
  employeeId    String
  amount        Float
  requestDate   DateTime
  reason        String
  status        AdvanceStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  deductMonth   Int?
  deductYear    Int?
  payrollItemId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

model EmployeeLoan {
  id            String             @id @default(cuid())
  employeeId    String
  totalAmount   Float
  installmentCount Int
  monthlyAmount Float
  startDate     DateTime
  reason        String
  status        AdvanceStatus      @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  Employee      Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Installments  LoanInstallment[]
}

model LoanInstallment {
  id            String               @id @default(cuid())
  loanId        String
  installmentNo Int
  amount        Float
  dueDate       DateTime
  paidDate      DateTime?
  status        InstallmentPayStatus @default(PENDING_PAY)
  payrollItemId String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  Loan          EmployeeLoan         @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, status])
}

model PayrollPeriod {
  id         String       @id @default(cuid())
  month      Int
  year       Int
  startDate  DateTime
  endDate    DateTime
  companyId  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  PayrollRun PayrollRun[]

  @@unique([companyId, month, year])
}

model PayrollRun {
  id              String        @id @default(cuid())
  periodId        String
  status          PayrollStatus @default(DRAFT)
  totalGross      Float         @default(0)
  totalDeductions Float         @default(0)
  totalNet        Float         @default(0)
  employeeCount   Int           @default(0)
  calculatedAt    DateTime?
  calculatedBy    String?
  approvedBy      String?
  approvedAt      DateTime?
  lockedBy        String?
  lockedAt        DateTime?
  journalEntryId  String?
  notes           String?
  companyId       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Period          PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  Company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  Items           PayrollItem[]

  @@index([companyId, status])
}

model PayrollItem {
  id              String                 @id @default(cuid())
  payrollRunId    String
  employeeId      String
  basicSalary     Float                  @default(0)
  totalEarnings   Float                  @default(0)
  totalDeductions Float                  @default(0)
  grossSalary     Float                  @default(0)
  netSalary       Float                  @default(0)
  workedDays      Int                    @default(0)
  absentDays      Int                    @default(0)
  lateDays        Int                    @default(0)
  overtimeHours   Float                  @default(0)
  flag            PayrollItemFlag        @default(NONE)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  PayrollRun      PayrollRun             @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  Employee        Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  Components      PayrollItemComponent[]

  @@unique([payrollRunId, employeeId])
}

model PayrollItemComponent {
  id                String           @id @default(cuid())
  payrollItemId     String
  salaryComponentId String?
  label             String
  type              SalaryComponentType
  amount            Float            @default(0)
  createdAt         DateTime         @default(now())
  PayrollItem       PayrollItem      @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  SalaryComponent   SalaryComponent? @relation(fields: [salaryComponentId], references: [id])

  @@index([payrollItemId])
}

model TraineeInfo {
  id                 String    @id @default(cuid())
  employeeId         String    @unique
  university         String?
  faculty            String?
  trainingStartDate  DateTime?
  trainingEndDate    DateTime?
  trainingSupervisor String?
  trainingHours      Int       @default(0)
  evaluation         String?
  stipend            Float     @default(0)
  certificateIssued  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  Employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
